{
  "name": "soshbot",
  "version": "0.1.0",
  "private": true,
  "description": "Event booking and social media automation toolkit for small venues",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "mkdir -p .data && drizzle-kit push",
    "db:seed": "tsx db/seed.ts",
    "db:reset": "rm -f .data/soshbot.db && npm run db:push && npm run db:seed",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "better-sqlite3": "^12.11.1",
    "drizzle-orm": "^0.45.2",
    "next": "^16.3.2",
    "node-ical": "^0.27.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "satori": "^0.33.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.2",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.2",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
